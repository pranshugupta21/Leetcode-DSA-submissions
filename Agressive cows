class Solution {
  public:
  bool canweplace(vector<int>&stalls,int k,int stall){
      int n=stalls.size();
      int cntcows=1,last=stalls[0];
      for(int i=1;i<n;i++){
          if(stalls[i]-last>=stall){
              cntcows++;
              last=stalls[i];
          }
          if(cntcows==k) return true;
          
      }
      return false;
  }
    int aggressiveCows(vector<int> &stalls, int k) {
        // code here
        int n=stalls.size();
         sort(stalls.begin(),stalls.end());
    int low=1,high=stalls[n-1]-stalls[0];
    while(low<=high){
        int mid=(low+high)/2;
        if(canweplace(stalls,k,mid)==true){
            low=mid+1;
        }
        else{
            high=mid-1;
        }
    }
    return high;
        
    }
};
